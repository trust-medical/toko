{
  "name": "trust-medical/toko",
  "version": "0.3.2",
  "description": "Article management models for Laravel.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/database": "^11.0|^12.0",
    "illuminate/support": "^11.0|^12.0"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "larastan/larastan": "^3.0",
    "orchestra/testbench": "^9.0|^10.0",
    "phpunit/phpunit": "^10.0|^11.0",
    "filament/support": "^4.0 || ^5.0"
  },
  "autoload": {
    "psr-4": {
      "TrustMedical\\Toko\\": "src/",
      "TrustMedical\\Toko\\Database\\Factories\\": "database/factories/",
      "TrustMedical\\Toko\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TrustMedical\\Toko\\Tests\\": "tests/"
    }
  },
  "suggest": {
    "laravel/boost": "Optional: Laravel Boost guidelines and MCP tooling for AI-assisted development."
  },
  "extra": {
    "laravel": {
      "providers": [
        "TrustMedical\\Toko\\TokoServiceProvider"
      ]
    }
  },
  "scripts": {
    "analyze": "phpstan analyse --memory-limit=512M",
    "lint": "pint",
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
